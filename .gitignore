.DS_Store
node_modules/
dist/
*.bundle
.cv-venv/
# uv environments (cube-tools/py312, py313-cltk): built by uv sync, never source
.venv/
*.log
# conductor runtime state (session workspaces + traces), never source
native/state/
state/

# generated reading outputs: stores, ledgers, logs and run reports (reproducible from the scripts; some hold verbatim closed-licence testimony,
# and one `git add -A` away from a rejected push). Commit the SCRIPTS that write them, never these.
native/eval/the-fold/scene/*-weft/
native/eval/the-fold/scene/*-weft.v*/
native/eval/the-fold/scene/read-batch-ledger.jsonl
native/eval/the-fold/scene/foundation-manifest.json
native/eval/the-fold/scene/*.log.jsonl
native/eval/the-fold/scene/republic-*.jsonl
native/eval/the-fold/scene/historicity-witnesses.jsonl
native/eval/the-fold/results/readings/

# ── runtime data and eval artifacts: never source ───────────────────────
# Claude Code / reader session transcripts
documents/
# ledgers, logs and per-session reader state
*.jsonl
native/moral-shadows/
native/the-fold/speaker-models/
# evaluation and reading artifacts: generated data stays out.
# Code under native/eval (*.mjs/*.js/*.ts/*.py/*.sh/*.rb/*.m/*.java) stays in.
native/eval/**
!native/eval/**/
!native/eval/**/*.mjs
!native/eval/**/*.js
!native/eval/**/*.ts
!native/eval/**/*.py
!native/eval/**/*.sh
!native/eval/**/*.rb
!native/eval/**/*.m
!native/eval/**/*.java
