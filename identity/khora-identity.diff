+      const about = new Set(claims.filter((k) => k.roles.ARG0 === x || k.roles.ARG0 === y).map((k) => k.id));
+      const raised = lintGfp([...claims, c("same-as", x, y, "sid")], OPTS).findings.some((f) => KINDS.has(f.kind) && (f.claims || []).some((id) => about.has(id)) && !base.has(`${f.kind}|${(f.claims || []).join(",")}`));
