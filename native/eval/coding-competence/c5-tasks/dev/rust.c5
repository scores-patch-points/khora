@@@@ task fibonacci
fn fibonacci(n: i64) -> i64 {
    if n < 2 {
        return n;
    }
    fibonacci(n - 1) + fibonacci(n - 2)
}

fn main() {
    let parts: Vec<String> = (0..=10).map(|i| fibonacci(i).to_string()).collect();
    println!("{}", parts.join(" "));
}
@@@@ task gcd
fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 {
        return a;
    }
    gcd(b, a % b)
}

fn main() {
    let pairs = [(48, 18), (17, 5), (0, 9), (100, 75)];
    let parts: Vec<String> = pairs.iter().map(|&(a, b)| gcd(a, b).to_string()).collect();
    println!("{}", parts.join(" "));
}
@@@@ task binary_search
fn search_range(items: &[i64], target: i64, low: i64, high: i64) -> i64 {
    if low > high {
        return -1;
    }
    let mid = (low + high) / 2;
    if items[mid as usize] == target {
        return mid;
    }
    if items[mid as usize] < target {
        return search_range(items, target, mid + 1, high);
    }
    search_range(items, target, low, mid - 1)
}

fn binary_search(items: &[i64], target: i64) -> i64 {
    search_range(items, target, 0, items.len() as i64 - 1)
}

fn main() {
    let data = [1, 3, 5, 7, 9, 11, 13];
    let parts: Vec<String> = [7, 1, 13, 4].iter().map(|&t| binary_search(&data, t).to_string()).collect();
    println!("{}", parts.join(" "));
}
@@@@ task quicksort
fn partition(items: &mut [i64], low: i64, high: i64) -> i64 {
    let pivot = items[high as usize];
    let mut i = low - 1;
    for j in low..high {
        if items[j as usize] <= pivot {
            i += 1;
            items.swap(i as usize, j as usize);
        }
    }
    items.swap((i + 1) as usize, high as usize);
    i + 1
}

fn quicksort(items: &mut [i64], low: i64, high: i64) {
    if low < high {
        let p = partition(items, low, high);
        quicksort(items, low, p - 1);
        quicksort(items, p + 1, high);
    }
}

fn main() {
    let mut data = [5, 2, 9, 1, 5, 6, 0, 3];
    let last = data.len() as i64 - 1;
    quicksort(&mut data, 0, last);
    let parts: Vec<String> = data.iter().map(|x| x.to_string()).collect();
    println!("{}", parts.join(" "));
}
@@@@ task merge_sort
fn merge(left: &[i64], right: &[i64]) -> Vec<i64> {
    let mut result = Vec::new();
    let mut i = 0;
    let mut j = 0;
    while i < left.len() && j < right.len() {
        if left[i] <= right[j] {
            result.push(left[i]);
            i += 1;
        } else {
            result.push(right[j]);
            j += 1;
        }
    }
    result.extend_from_slice(&left[i..]);
    result.extend_from_slice(&right[j..]);
    result
}

fn merge_sort(items: &[i64]) -> Vec<i64> {
    if items.len() <= 1 {
        return items.to_vec();
    }
    let mid = items.len() / 2;
    merge(&merge_sort(&items[..mid]), &merge_sort(&items[mid..]))
}

fn main() {
    let sorted = merge_sort(&[38, 27, 43, 3, 9, 82, 10]);
    let parts: Vec<String> = sorted.iter().map(|x| x.to_string()).collect();
    println!("{}", parts.join(" "));
}
@@@@ task factorial
fn factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1;
    }
    n * factorial(n - 1)
}

fn main() {
    let parts: Vec<String> = (0..=10).map(|i| factorial(i).to_string()).collect();
    println!("{}", parts.join(" "));
}
@@@@ task palindrome
fn normalize(text: &str) -> String {
    let mut out = String::new();
    for ch in text.chars() {
        if ch.is_alphanumeric() {
            out.push(ch.to_ascii_lowercase());
        }
    }
    out
}

fn reverse_text(text: &str) -> String {
    let mut out = String::new();
    for ch in text.chars() {
        out.insert(0, ch);
    }
    out
}

fn is_palindrome(text: &str) -> bool {
    let cleaned = normalize(text);
    cleaned == reverse_text(&cleaned)
}

fn main() {
    let samples = ["A man, a plan, a canal: Panama", "hello", "Was it a car or a cat I saw?"];
    let parts: Vec<String> = samples.iter().map(|s| is_palindrome(s).to_string()).collect();
    println!("{}", parts.join(" "));
}
@@@@ task word_count
use std::collections::BTreeMap;

fn split_words(text: &str) -> Vec<&str> {
    text.split(' ').collect()
}

fn count_words(text: &str) -> BTreeMap<String, usize> {
    let mut counts = BTreeMap::new();
    for word in split_words(text) {
        *counts.entry(word.to_string()).or_insert(0) += 1;
    }
    counts
}

fn main() {
    let counts = count_words("the quick brown fox jumps over the lazy dog the end");
    let parts: Vec<String> = counts.iter().map(|(w, c)| format!("{}={}", w, c)).collect();
    println!("{}", parts.join(" "));
}
@@@@ task fizzbuzz
fn is_divisible(n: i64, d: i64) -> bool {
    n % d == 0
}

fn fizz_buzz(n: i64) -> String {
    if is_divisible(n, 15) {
        return "FizzBuzz".to_string();
    }
    if is_divisible(n, 3) {
        return "Fizz".to_string();
    }
    if is_divisible(n, 5) {
        return "Buzz".to_string();
    }
    n.to_string()
}

fn main() {
    let parts: Vec<String> = (1..=15).map(|i| fizz_buzz(i)).collect();
    println!("{}", parts.join(" "));
}
@@@@ task linked_list
struct Node {
    value: i64,
    next: Option<Box<Node>>,
}

fn reverse_list(node: Option<Box<Node>>, previous: Option<Box<Node>>) -> Option<Box<Node>> {
    match node {
        None => previous,
        Some(mut current) => {
            let following = current.next.take();
            current.next = previous;
            reverse_list(following, Some(current))
        }
    }
}

fn to_array(node: &Option<Box<Node>>) -> Vec<i64> {
    let mut values = Vec::new();
    let mut current = node;
    while let Some(n) = current {
        values.push(n.value);
        current = &n.next;
    }
    values
}

fn main() {
    let mut head: Option<Box<Node>> = None;
    for &v in [5, 4, 3, 2, 1].iter() {
        head = Some(Box::new(Node { value: v, next: head }));
    }
    let values = to_array(&reverse_list(head, None));
    let parts: Vec<String> = values.iter().map(|v| v.to_string()).collect();
    println!("{}", parts.join(" "));
}
@@@@ task stack
struct Stack {
    items: Vec<i64>,
}

impl Stack {
    fn new() -> Stack {
        Stack { items: Vec::new() }
    }

    fn push(&mut self, value: i64) {
        self.items.insert(self.items.len(), value);
    }

    fn is_empty(&self) -> bool {
        self.items.len() == 0
    }

    fn pop(&mut self) -> i64 {
        if self.is_empty() {
            panic!("pop from empty stack");
        }
        let value = self.items[self.items.len() - 1];
        self.items.truncate(self.items.len() - 1);
        value
    }

    fn peek(&self) -> i64 {
        if self.is_empty() {
            panic!("peek at empty stack");
        }
        self.items[self.items.len() - 1]
    }
}

fn main() {
    let mut stack = Stack::new();
    for &v in [1, 2, 3].iter() {
        stack.push(v);
    }
    let out = vec![
        stack.peek().to_string(),
        stack.pop().to_string(),
        stack.pop().to_string(),
        stack.is_empty().to_string(),
        stack.pop().to_string(),
        stack.is_empty().to_string(),
    ];
    println!("{}", out.join(" "));
}
@@@@ task tree_traversal
struct TreeNode {
    value: i64,
    left: Option<Box<TreeNode>>,
    right: Option<Box<TreeNode>>,
}

fn inorder(node: &Option<Box<TreeNode>>, out: &mut Vec<i64>) {
    if let Some(n) = node {
        inorder(&n.left, out);
        out.push(n.value);
        inorder(&n.right, out);
    }
}

fn preorder(node: &Option<Box<TreeNode>>, out: &mut Vec<i64>) {
    if let Some(n) = node {
        out.push(n.value);
        preorder(&n.left, out);
        preorder(&n.right, out);
    }
}

fn main() {
    let root = Some(Box::new(TreeNode {
        value: 4,
        left: Some(Box::new(TreeNode {
            value: 2,
            left: Some(Box::new(TreeNode { value: 1, left: None, right: None })),
            right: Some(Box::new(TreeNode { value: 3, left: None, right: None })),
        })),
        right: Some(Box::new(TreeNode {
            value: 6,
            left: Some(Box::new(TreeNode { value: 5, left: None, right: None })),
            right: Some(Box::new(TreeNode { value: 7, left: None, right: None })),
        })),
    }));
    let mut visited = Vec::new();
    inorder(&root, &mut visited);
    let first: Vec<String> = visited.iter().map(|v| v.to_string()).collect();
    println!("{}", first.join(" "));
    let mut visited = Vec::new();
    preorder(&root, &mut visited);
    let second: Vec<String> = visited.iter().map(|v| v.to_string()).collect();
    println!("{}", second.join(" "));
}
