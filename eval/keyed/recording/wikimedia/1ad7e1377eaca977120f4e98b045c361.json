,"type":"wikibase-entityid"},"datatype":"wikibase-item"}]},"qualifiers-order":["P5008"],"id":"P5008$ec494c2d-4990-4a1d-01ee-9326abbc0cbd","rank":"normal"}],"P2559":[{"mainsnak":{"snaktype":"value","property":"P2559","hash":"cdc751f47caa9c33be29a377f5b514fb63ffc0f5","datavalue":{"value":{"text":"This property does not add notability to items. Items should not be created with this property if not otherwise notable for Wikidata. Don't use it when querying another property returns a comparable list.","language":"en"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"P5008$641c4353-4030-fccf-1147-fe924ffb3a09","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"4c75bd27c956ee19e72e56060042dbc09d56fc98","datavalue":{"value":{"text":"Die Präsenz dieser Eigenschaft impliziert kein Erfüllen der Relevanzkriterien, deshalb sollten Objekte nur dann erstellt werden, wenn sie anderweitig für Wikidata relevant sind. Diese Eigenschaft sollte nicht genutzt werden, wenn mit einer anderen, generischen Eigenschaft eine ähnliche Liste erstellt werden kann.","language":"de"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"P5008$245d6f58-48ae-1b0e-2ede-44e63e71cf39","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"9bd5234e2a20cb0731d54f51d4bc87e1dd40acd0","datavalue":{"value":{"text":"此属性不会增加数据项的关注度，项不能在只有该属性而没有其他关注度的情况下创建。在查询另一属性将提供可比较列表时不要使用它。","language":"zh-hans"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"P5008$5285908f-4180-ccc4-5f13-a4b8944d6803","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"8cd97ac043d89e8737c76735e10d4b16d5748f55","datavalue":{"value":{"text":"Esta propiedá nun añade notabilidá a los elementos, y estos nun tendríen de crease con esta propiedá si nun son notables d'otra manera pa Wikidata. Nun usar si al consultar otra propiedá apaez una llista comparable.","language":"ast"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"P5008$5108d2d6-4103-7585-5ae8-79faa655d35a","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"1706ac0acc04c436a60015695170beb39ef75255","datavalue":{"value":{"text":"Deze eigenschap voegt geen relevantie toe aan items. Items moeten niet worden gemaakt met deze eigenschap als ze niet anders opmerkelijk zijn voor Wikidata. Gebruik het niet als een andere eigenschap een vergelijkbare lijst oplevert.","language":"nl"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"P5008$eb71d884-4d72-1af3-af94-1f68ad604bc8","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"fc57991e0121b330e5a0a56282917e43e27ed106","datavalue":{"value":{"text":"Tato vlastnost nepřidává položkám na významnosti. Položky by neměly být vytvářeny s touto vlastností, pokud nejsou pro Wikidata jinak pozoruhodné.","language":"cs"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"P5008$7cd793b4-428a-9397-2ca2-6adf8b05db8e","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"c689ca9f4833ea09110abba38232d4078b17ba44","datavalue":{"value":{"text":"Ця властивість не додає елементам значущості. Не слід створювати елементи з цією властивістю, якщо вони не є значущими для Вікіданих в інший спосіб. Не використовуйте її, якщо запит щодо іншої властивості повертає подібний список.","language":"uk"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"P5008$6c0fb120-46fb-3fd5-325c-e8c44063b502","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"cc2c8cc5b0713f7c951609aefa42d02b53e3aca2","datavalue":{"value":{"text":"Bu özellik maddelere kayda değerlik katmaz. Vikiveri için başka türlü kayda değer değilse maddeler bu özellikle oluşturulmamalıdır. Başka bir özelliği sorguladığınızda karşılaştırılabilir bir liste döndürüyorsa bu özelliği kullanmayın","language":"tr"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"P5008$babf6f9f-4b67-33f6-f21d-4e3d38ac0ea8","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P2559","hash":"476e442b68cad3c04a40a2aad918e2b2c53486ca","datavalue":{"value":{"text":"بو اوزلليك ماددلره كايدا دغرليك كاتماز. ويكيورى ايچين باشكا تورلو كايدا دغر دغيلسه ماددلر بو اوزلليكله اولوشتورولماماليدير. باشكا بير اوزلليغى سوركولاديغينيزدا كارشيلاشتيريلابيلير بير ليسته دوندورويورسا بو اوزلليغى كوللانمايين","language":"ota"},"type":"monolingualtext"},"datatype":"monolingualtext"},"type":"statement","id":"P5008$511ed46e-40c1-1920-d04e-964f372b7d3e","rank":"normal"}],"P3254":[{"mainsnak":{"snaktype":"value","property":"P3254","hash":"a541b12cd7aab3940a0e61d65817b1644b13e3b3","datavalue":{"value":"https://www.wikidata.org/wiki/Wikidata:Property_proposal/Wikidata_focus_list","type":"string"},"datatype":"url"},"type":"statement","id":"P5008$3f804bfc-4949-9440-e78d-8b4c6d86d1f4","rank":"normal"}],"P2302":[{"mainsnak":{"snaktype":"value","property":"P2302","hash":"f682b0724a7ad8a25fffc7b602c4ecab3d8c6274","datavalue":{"value":{"entity-type":"item","numeric-id":21510865,"id":"Q21510865"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","qualifiers":{"P2308":[{"snaktype":"value","property":"P2308","hash":"19fdf9daa8922932a4ea2a9ba3a7bd3e6f3ea607","datavalue":{"value":{"entity-type":"item","numeric-id":16695773,"id":"Q16695773"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},{"snaktype":"value","property":"P2308","hash":"ab7c1f0af9afcf2aebf7181d2b69a0c2c7f32f23","datavalue":{"value":{"entity-type":"item","numeric-id":128273850,"id":"Q128273850"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},{"snaktype":"value","property":"P2308","hash":"c8acaec2b39b77a6abc4534e7aa57d3336d8ffb2","datavalue":{"value":{"entity-type":"item","numeric-id":51539995,"id":"Q51539995"},"type":"wikibase-entityid"},"datatype":"wikibase-item"}],"P2309":[{"snaktype":"valu